// ---------- Timeline ----------
struct LyricFrame {
  unsigned long time;
  const unsigned char* bitmap; // nullptr = blank frame
};

LyricFrame lyrics[] = {
  {0, nullptr},
  {500, img1Bitmap},
  {2600, img2Bitmap},
  {4500, img3Bitmap},
  {5233, img4Bitmap},
  {7067, img5Bitmap},
  {8300, img6Bitmap},
  {10033, nullptr},
  {10400, img7Bitmap},
  {12467, img8Bitmap},
  {13100, img9Bitmap},
  {15133, img10Bitmap},
  {15600, img11Bitmap},
  {16700, img12Bitmap},
  {18167, img13Bitmap},
};

int totalFrames = 15;
int currentFrame = 0;
unsigned long songStartTime;

unsigned long outroStartTime = 20000;
unsigned long blinkTimer = 0;
bool subscribeVisible = true;

void setup() {
  if (!oled.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    while (true);
  }
  oled.setTextColor(SSD1306_WHITE);

  showReady();
  delay(2000);

  runCountdown();
  songStartTime = millis();
}

void loop() {
  unsigned long elapsed = millis() - songStartTime;

  if (currentFrame < totalFrames && elapsed >= lyrics[currentFrame].time) {
    oled.clearDisplay();
    if (lyrics[currentFrame].bitmap != nullptr) {
      oled.drawBitmap(0, 0, lyrics[currentFrame].bitmap, 128, 64, SSD1306_WHITE);
    }
    oled.display();
    currentFrame++;
  }

  if (currentFrame >= totalFrames && elapsed >= outroStartTime) {
    animateOutro();
  }
}

void animateOutro() {
  if (millis() - blinkTimer >= 500) {
    blinkTimer = millis();
    subscribeVisible = !subscribeVisible;

    oled.clearDisplay();
    oled.setTextSize(2);
    oled.setCursor(15, 5);
    oled.print("See you");
    oled.setCursor(10, 25);
    oled.print("in Day 8");

    if (subscribeVisible) {
      oled.setCursor(5, 48);
      oled.print("SUBSCRIBE");
    }

    oled.display();
  }
}

void showReady() {
  oled.clearDisplay();
  oled.setTextSize(2);
  oled.setCursor(0, 0);
  oled.print("Ready");
  oled.display();
}

void runCountdown() {
  int nums[] = {3, 2, 1};
  for (int i = 0; i < 3; i++) {
    oled.clearDisplay();
    oled.setTextSize(4);
    oled.setCursor(56, 24);
    oled.print(nums[i]);
    oled.display();
    delay(1000);
  }
  oled.clearDisplay();
  oled.display();
}
